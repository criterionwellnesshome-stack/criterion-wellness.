{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criterion-wellness",
  "pages_build_output_dir": ".",
  "compatibility_date": "2024-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "criterion-wellness-db",
      "database_id": "0e77c45b-2c08-46e6-ab0b-109b202caa68"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "criterion-wellness-media"
    }
  ]
}
