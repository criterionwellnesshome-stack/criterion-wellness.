{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criterion-wellness",
  "pages_build_output_dir": ".",
  "compatibility_date": "2024-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "criterion-herbal-store-staging",
      "database_id": "c34741aa-1402-429c-b2b4-cde107b6bcd4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "criterion-wellness-media"
    }
  ]
}
